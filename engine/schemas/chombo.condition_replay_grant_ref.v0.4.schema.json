{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://chombo.local/schemas/chombo.condition_replay_grant_ref.v0.4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["document_kind", "schema_id", "format_version", "created_at", "producer", "integrity", "grant_id", "user_id", "record_hash", "scope", "allowed_participant_ids", "expires_at", "cancellation_revision"],
  "properties": {
    "document_kind": {"const": "CONDITION_REPLAY_GRANT_REF"}, "schema_id": {"const": "https://chombo.local/schemas/chombo.condition_replay_grant_ref.v0.4.schema.json"}, "format_version": {"const": "1.0.0"}, "created_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"}, "integrity": {"$ref": "#/$defs/integrity"}, "grant_id": {"$ref": "#/$defs/id"}, "user_id": {"$ref": "#/$defs/id"}, "record_hash": {"$ref": "#/$defs/hash"},
    "scope": {"type": "string", "maxLength": 256}, "allowed_participant_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "expires_at": {"type": "string", "format": "date-time"}, "cancellation_revision": {"type": "integer", "minimum": 0}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "producer": {"type": "object", "additionalProperties": false, "required": ["app_id", "app_version", "build_revision", "engine_version"], "properties": {"app_id": {"type": "string"}, "app_version": {"type": "string"}, "build_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "engine_version": {"type": "string"}}}, "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "document_hash"], "properties": {"algorithm": {"const": "canonical-json-sha256.v1"}, "document_hash": {"$ref": "#/$defs/hash"}}}}
}
