{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chombo.local/schemas/complete_rule_profile_scope.v1.schema.json",
  "title": "Chombo complete rule profile scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "applies_to",
    "required_dimensions",
    "common_exclusions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "applies_to": {"const": "four_player_east_south_match"},
    "required_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "stage"],
        "properties": {
          "dimension_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "stage": {
            "enum": [
              "match_start",
              "hand_progress",
              "hand_settlement",
              "hand_transition",
              "match_end",
              "final_points"
            ]
          }
        }
      }
    },
    "common_exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category_id", "disposition"],
        "properties": {
          "category_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "disposition": {"const": "REJECT_AS_INPUT_OR_INVARIANT_VIOLATION"}
        }
      }
    }
  }
}
