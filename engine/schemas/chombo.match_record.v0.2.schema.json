{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chombo.local/schemas/chombo.match_record.v0.2.schema.json",
  "title": "Chombo v0.2 east-south match record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_format", "match_id", "format", "seed", "rule_profile_id", "rule_snapshot_id", "participants", "hands", "transitions", "result", "integrity"],
  "properties": {
    "schema_version": {"const": "chombo.match_record.v0.2"},
    "record_format": {"const": "semantic-delta.v2"},
    "match_id": {"type": "string", "minLength": 1},
    "format": {"const": "east_south"},
    "seed": {"type": "integer"},
    "rule_profile_id": {"type": "string", "minLength": 1},
    "rule_snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "participants": {"type": "array", "minItems": 4, "maxItems": 4},
    "hands": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "transitions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "result": {"type": "object"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hands", "record_hash"],
      "properties": {
        "algorithm": {"const": "canonical-json-sha256.v1"},
        "hands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hand_id", "initial_state_hash", "events", "final_state_hash"],
            "properties": {
              "hand_id": {"type": "string", "minLength": 1},
              "initial_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sequence", "event_id", "before_state_hash", "after_state_hash", "event_hash"],
                  "properties": {
                    "sequence": {"type": "integer", "minimum": 0},
                    "event_id": {"type": "string", "minLength": 1},
                    "before_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "after_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                  }
                }
              },
              "final_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
