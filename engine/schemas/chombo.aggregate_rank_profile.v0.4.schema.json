{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://chombo.local/schemas/chombo.aggregate_rank_profile.v0.4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["document_kind", "schema_id", "format_version", "created_at", "producer", "integrity", "profile_id", "profile_version", "content_hash", "source_snapshot", "participant_count", "value_representation", "comparison_direction", "tie_policy", "priority_criteria", "rounding", "addition_unit", "penalty_boundary", "concept_refs", "source_refs"],
  "properties": {
    "document_kind": {"const": "AGGREGATE_RANK_PROFILE"}, "schema_id": {"const": "https://chombo.local/schemas/chombo.aggregate_rank_profile.v0.4.schema.json"}, "format_version": {"const": "1.0.0"}, "created_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"}, "integrity": {"$ref": "#/$defs/integrity"}, "profile_id": {"$ref": "#/$defs/id"}, "profile_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "content_hash": {"$ref": "#/$defs/hash"},
    "source_snapshot": {"type": "object", "maxProperties": 256}, "participant_count": {"const": 4}, "value_representation": {"type": "object", "maxProperties": 256}, "comparison_direction": {"enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER"]},
    "tie_policy": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["SHARED_RANK", "ORDERED_PRIORITY"]}, "rank_numbering": {"enum": ["COMPETITION", "DENSE"]}}},
    "priority_criteria": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["PRE_ADDITION_AGGREGATE_RANK", "PROFILE_PARTICIPANT_ORDER", "SOURCE_DEFINED_EXTERNAL_SEED"]}},
    "rounding": {"type": "object", "additionalProperties": false, "required": ["stage", "mode", "input_scale", "output_scale"], "properties": {"stage": {"enum": ["NONE", "EACH_ADDITION", "AFTER_AGGREGATION", "DISPLAY_ONLY"]}, "mode": {"enum": ["NONE", "HALF_UP", "HALF_EVEN", "FLOOR", "CEILING", "TRUNCATE_TOWARD_ZERO"]}, "input_scale": {"type": "integer", "minimum": 0}, "output_scale": {"type": "integer", "minimum": 0}}},
    "addition_unit": {"const": "PARTICIPANT_FINAL_POINTS_PER_COMPLETED_SINGLE_MATCH"}, "penalty_boundary": {"type": "object", "maxProperties": 256}, "concept_refs": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "source_refs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "maxProperties": 256}}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "producer": {"type": "object", "additionalProperties": false, "required": ["app_id", "app_version", "build_revision", "engine_version"], "properties": {"app_id": {"type": "string"}, "app_version": {"type": "string"}, "build_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "engine_version": {"type": "string"}}}, "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "document_hash"], "properties": {"algorithm": {"const": "canonical-json-sha256.v1"}, "document_hash": {"$ref": "#/$defs/hash"}}}}
}
