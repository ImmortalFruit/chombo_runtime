{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chombo.local/schemas/chombo.match_record.v0.3.schema.json",
  "title": "Chombo v0.3 finalized east-south match record",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_kind", "schema_id", "format_version", "origin_kind", "record_state", "mutation_policy", "producer", "created_at", "baseline_status", "record_id", "lineage", "participants", "rules", "payload", "integrity"],
  "properties": {
    "document_kind": {"const": "MATCH_RECORD"},
    "schema_id": {"const": "https://chombo.local/schemas/chombo.match_record.v0.3.schema.json"},
    "format_version": {"const": "1.0.0"},
    "origin_kind": {"const": "CHOMBO_SESSION"},
    "record_state": {"const": "FINALIZED"},
    "mutation_policy": {"const": "IMMUTABLE"},
    "producer": {"$ref": "chombo.hand_record.v0.3.schema.json#/$defs/producer"},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_status": {"enum": ["EVALUATION", "RELEASED"]},
    "record_id": {"type": "string", "format": "uuid"},
    "lineage": {"$ref": "chombo.hand_record.v0.3.schema.json#/$defs/lineage"},
    "participants": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "chombo.hand_record.v0.3.schema.json#/$defs/participant"}},
    "rules": {"type": "object"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["match_id", "format", "seed", "hands", "transitions", "result"], "properties": {"match_id": {"type": "string", "minLength": 1}, "format": {"const": "east_south"}, "seed": {"type": "integer"}, "hands": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object"}}, "transitions": {"type": "array"}, "result": {"type": "object"}}},
    "integrity": {"$ref": "chombo.hand_record.v0.3.schema.json#/$defs/integrity"}
  }
}
